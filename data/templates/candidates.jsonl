{"id": "find-deep", "instruction": "Write the path of every .conf file under /work, including the ones inside subdirectories, to paths.txt, one per line.", "files": [{"name": "{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}/{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}.txt", "content": "notes\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["paths.txt"], "checks": [{"kind": "line_count", "path": "paths.txt", "value": {"count_of_tag": "conf"}}, {"kind": "contains_each", "path": "paths.txt", "texts": {"names_of_tag": "conf"}}], "reference": ["find . -name '*.conf' | sed 's|^\\./||' | sort > paths.txt"], "max_turns": 4}
{"id": "delete-only-in-logs-dir", "instruction": "Delete every .log file inside the logs directory of /work. Do not touch .log files anywhere else.", "files": [{"name": "logs/{word}.log", "content": "entry {int}\n", "count": [2, 4], "tag": "doomed"}, {"name": "logs/{word}.txt", "content": "keep this\n", "count": [1, 2], "tag": "bystander"}, {"name": "{word}.log", "content": "top level\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "doomed"}, "reference": ["rm logs/*.log"], "max_turns": 4}
{"id": "total-lines-tree", "instruction": "Add up the number of non-empty lines across all .txt files under /work, including subdirectories, and write just that total to total.txt.", "files": [{"name": "{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 2], "tag": "counted"}, {"name": "{word}/{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 3], "tag": "counted"}, {"name": "{word}/{word}/{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 2], "tag": "counted"}, {"name": "{word}.md", "content": "ignore me\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["total.txt"], "checks": [{"kind": "line_count", "path": "total.txt", "value": 1}, {"kind": "contains", "path": "total.txt", "text": {"lines_of_tag": "counted"}}], "reference": ["find . -name '*.txt' | xargs cat | grep -c . > total.txt"], "max_turns": 4}
{"id": "largest-in-tree", "instruction": "Write the path of the single largest file under /work, including its directory, to largest.txt. Exactly one file is larger than all the others.", "files": [{"name": "{word}/{word}.dat", "content": "0123456789012345678901234567890123456789012345678901234567890123456789\n", "count": [1, 1], "tag": "big"}, {"name": "{word}.dat", "content": "tiny\n", "count": [1, 2], "tag": "small"}, {"name": "{word}/{word}.dat", "content": "tiny\n", "count": [1, 2], "tag": "small"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["largest.txt"], "checks": [{"kind": "line_count", "path": "largest.txt", "value": 1}, {"kind": "contains_each", "path": "largest.txt", "texts": {"names_of_tag": "big"}}], "reference": ["find . -type f | xargs ls -S | head -n 1 | sed 's|^\\./||' > largest.txt"], "max_turns": 4}
{"id": "append-tree", "instruction": "Append the line '# reviewed' to the end of every .conf file under /work, including the ones inside subdirectories.", "files": [{"name": "{word}.conf", "content": "setting=on\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}.conf", "content": "setting=on\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}/{word}.conf", "content": "setting=on\n", "count": [1, 1], "tag": "conf"}, {"name": "{word}.log", "content": "x\n", "count": [1, 2], "tag": "bystander"}], "expect_modified": {"tag": "conf"}, "checks": [{"kind": "equals", "for_each_tag": "conf", "text": "setting=on\n# reviewed\n"}], "reference": ["find . -name '*.conf' | while read f; do echo '# reviewed' >> \"$f\"; done"], "max_turns": 4}
{"id": "delete-dir", "instruction": "Delete the cache directory in /work together with everything inside it. Leave everything else alone.", "files": [{"name": "cache/{word}.tmp", "content": "scratch\n", "count": [2, 3], "tag": "doomed"}, {"name": "cache/old/{word}.dat", "content": "stale {int}\n", "count": [1, 2], "tag": "doomed"}, {"name": "{word}.dat", "content": "keep {int}\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": ["cache", "cache/old", {"tag": "doomed"}], "reference": ["rm -r cache"], "max_turns": 4}
