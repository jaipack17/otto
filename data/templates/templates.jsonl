{"id": "count-logs", "instruction": "Count how many .log files are in /work and write just that number to count.txt.", "files": [{"name": "{word}.log", "content": "line {int}\n", "count": [2, 6], "tag": "logs"}, {"name": "{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["count.txt"], "checks": [{"kind": "line_count", "path": "count.txt", "value": 1}, {"kind": "contains", "path": "count.txt", "text": {"count_of_tag": "logs"}}], "reference": ["ls -1 *.log | wc -l > count.txt"], "max_turns": 3}
{"id": "delete-empty", "instruction": "Some files in /work are completely empty. Delete every empty file. Do not touch any file that has content.", "files": [{"name": "{word}.dat", "content": "", "count": [2, 4], "tag": "empty"}, {"name": "{word}.dat", "content": "payload {int}\n", "count": [1, 3], "tag": "filled"}, {"name": "{word}.conf", "content": "keep=1\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "empty"}, "checks": [], "reference": ["find . -type f -empty -delete"], "max_turns": 3}
{"id": "list-dats", "instruction": "Write the name of every .dat file in /work to manifest.txt, one per line, sorted alphabetically.", "files": [{"name": "{word}.dat", "content": "x {int}\n", "count": [2, 5], "tag": "dats"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 3], "tag": "bystander"}], "expect_created": ["manifest.txt"], "checks": [{"kind": "line_count", "path": "manifest.txt", "value": {"count_of_tag": "dats"}}, {"kind": "contains_each", "path": "manifest.txt", "texts": {"basenames_of_tag": "dats"}}], "reference": ["ls -1 *.dat | sort > manifest.txt"], "max_turns": 3}
{"id": "total-lines", "instruction": "Add up the number of non-empty lines across all .txt files in /work and write just that total to total.txt.", "files": [{"name": "{word}.txt", "content": "alpha\nbeta\n", "count": [2, 4], "tag": "counted"}, {"name": "{word}.md", "content": "ignore me\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["total.txt"], "checks": [{"kind": "line_count", "path": "total.txt", "value": 1}, {"kind": "contains", "path": "total.txt", "text": {"lines_of_tag": "counted"}}], "reference": ["cat *.txt | grep -c . > total.txt"], "max_turns": 3}
{"id": "chmod-scripts", "instruction": "Make every .sh file in /work executable by setting its permissions to 0755. Leave all other files alone.", "files": [{"name": "{word}.sh", "content": "#!/bin/sh\necho {int}\n", "count": [2, 4], "tag": "script", "mode": "0644"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 2], "tag": "bystander"}], "expect_modified": {"tag": "script"}, "checks": [{"kind": "mode", "for_each_tag": "script", "value": "0755"}], "reference": ["chmod 0755 *.sh"], "max_turns": 3}
{"id": "stale-logs", "instruction": "Some .log files under /work are stale: their first line is exactly 'old'. Delete every stale .log file, then write the path of each file you deleted to removed.txt, one per line. Leave every other file exactly as it is.", "files": [{"name": "{word}.log", "content": "old\n", "count": [2, 4], "tag": "stale"}, {"name": "sub/{word}.log", "content": "old\n", "count": [0, 2], "tag": "stale"}, {"name": "{word}.log", "content": "keep\n", "count": [1, 3], "tag": "fresh"}, {"name": "{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "stale"}, "expect_created": ["removed.txt"], "checks": [{"kind": "line_count", "path": "removed.txt", "value": {"count_of_tag": "stale"}}, {"kind": "contains_each", "path": "removed.txt", "texts": {"names_of_tag": "stale"}}], "reference": ["grep -rl '^old$' --include='*.log' . | sed 's|^\\./||' | sort > removed.txt", "xargs -r rm < removed.txt"], "max_turns": 5}
{"id": "secure-keys", "instruction": "Every .key file in /work is readable by other users, which is unsafe. Set each .key file's permissions to 0600. Change nothing else.", "files": [{"name": "{word}.key", "content": "secret-{hex}\n", "count": [2, 4], "tag": "key", "mode": "0644"}, {"name": "{word}.pub", "content": "public-{hex}\n", "count": [1, 2], "tag": "bystander"}], "expect_modified": {"tag": "key"}, "checks": [{"kind": "mode", "for_each_tag": "key", "value": "0600"}], "reference": ["chmod 0600 *.key"], "max_turns": 3}
{"id": "purge-tmp", "instruction": "Delete every .tmp file anywhere under /work, including inside subdirectories, and write the path of each one you deleted to purged.txt, one per line.", "files": [{"name": "{word}.tmp", "content": "scratch\n", "count": [1, 3], "tag": "tmp"}, {"name": "cache/{word}.tmp", "content": "scratch\n", "count": [1, 2], "tag": "tmp"}, {"name": "{word}.dat", "content": "keep {int}\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "tmp"}, "expect_created": ["purged.txt"], "checks": [{"kind": "line_count", "path": "purged.txt", "value": {"count_of_tag": "tmp"}}, {"kind": "contains_each", "path": "purged.txt", "texts": {"names_of_tag": "tmp"}}], "reference": ["find . -name '*.tmp' -type f | sed 's|^\\./||' | sort > purged.txt", "xargs -r rm < purged.txt"], "max_turns": 5}
{"id": "truncate-logs", "instruction": "Empty out every .log file in /work so that each one becomes zero bytes, but do not delete any of them.", "files": [{"name": "{word}.log", "content": "noise {int}\nmore noise\n", "count": [2, 4], "tag": "logs"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 2], "tag": "bystander"}], "expect_modified": {"tag": "logs"}, "checks": [{"kind": "equals", "for_each_tag": "logs", "text": ""}], "reference": ["for f in *.log; do : > \"$f\"; done"], "max_turns": 3}
{"id": "split-by-status", "instruction": "Each .log file in /work has 'old' or 'current' as its first line. Write the names of the old ones to old.txt and the names of the current ones to current.txt, one per line each. Do not delete anything.", "files": [{"name": "{word}.log", "content": "old\n", "count": [1, 3], "tag": "old"}, {"name": "{word}.log", "content": "current\n", "count": [1, 3], "tag": "current"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["old.txt", "current.txt"], "checks": [{"kind": "line_count", "path": "old.txt", "value": {"count_of_tag": "old"}}, {"kind": "contains_each", "path": "old.txt", "texts": {"basenames_of_tag": "old"}}, {"kind": "line_count", "path": "current.txt", "value": {"count_of_tag": "current"}}, {"kind": "contains_each", "path": "current.txt", "texts": {"basenames_of_tag": "current"}}], "reference": ["grep -l '^old$' *.log | sort > old.txt", "grep -l '^current$' *.log | sort > current.txt"], "max_turns": 5}
{"id": "count-nested", "instruction": "Count the .log files that live inside the sub directory of /work, and write just that number to nested.txt.", "files": [{"name": "sub/{word}.log", "content": "entry {int}\n", "count": [2, 5], "tag": "nested"}, {"name": "{word}.log", "content": "top level\n", "count": [1, 3], "tag": "bystander"}], "expect_created": ["nested.txt"], "checks": [{"kind": "line_count", "path": "nested.txt", "value": 1}, {"kind": "contains", "path": "nested.txt", "text": {"count_of_tag": "nested"}}], "reference": ["ls -1 sub/*.log | wc -l > nested.txt"], "max_turns": 3}
{"id": "checksum-manifest", "instruction": "Write a sha256 checksum line for every .dat file in /work into sums.txt, using the same format sha256sum produces.", "files": [{"name": "{word}.dat", "content": "payload-{hex}\n", "count": [2, 4], "tag": "dats"}, {"name": "{word}.log", "content": "ignore\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["sums.txt"], "checks": [{"kind": "line_count", "path": "sums.txt", "value": {"count_of_tag": "dats"}}, {"kind": "contains_each", "path": "sums.txt", "texts": {"basenames_of_tag": "dats"}}, {"kind": "regex", "path": "sums.txt", "pattern": "^[0-9a-f]{64} ", "multiline": true}], "reference": ["sha256sum *.dat > sums.txt"], "max_turns": 4}
{"id": "flag-writable", "instruction": "Some files in /work are world-writable, which is a security problem. Write the name of every world-writable file to insecure.txt, one per line, and do not change any permissions.", "files": [{"name": "{word}.conf", "content": "setting={int}\n", "count": [2, 4], "tag": "loose", "mode": "0666"}, {"name": "{word}.conf", "content": "setting={int}\n", "count": [1, 2], "tag": "tight", "mode": "0644"}, {"name": "{word}.dat", "content": "data\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["insecure.txt"], "checks": [{"kind": "line_count", "path": "insecure.txt", "value": {"count_of_tag": "loose"}}, {"kind": "contains_each", "path": "insecure.txt", "texts": {"basenames_of_tag": "loose"}}], "reference": ["find . -maxdepth 1 -type f -perm -o+w | sed 's|^\\./||' | sort > insecure.txt"], "max_turns": 4}
{"id": "dedupe-report", "instruction": "Several .dat files in /work share the exact same contents as each other. Write the name of every .dat file that has a duplicate to dupes.txt, one per line.", "files": [{"name": "{word}.dat", "content": "SHARED-PAYLOAD\n", "count": [2, 4], "tag": "dupe"}, {"name": "{word}.dat", "content": "unique-{hex}\n", "count": [1, 2], "tag": "unique"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["dupes.txt"], "checks": [{"kind": "line_count", "path": "dupes.txt", "value": {"count_of_tag": "dupe"}}, {"kind": "contains_each", "path": "dupes.txt", "texts": {"basenames_of_tag": "dupe"}}], "reference": ["grep -l '^SHARED-PAYLOAD$' *.dat | sort > dupes.txt"], "max_turns": 5}
{"id": "move-to-archive", "instruction": "Create a directory called archive in /work, then delete every .bak file from /work after recording its name in archive/manifest.txt, one per line.", "files": [{"name": "{word}.bak", "content": "backup {int}\n", "count": [2, 4], "tag": "bak"}, {"name": "{word}.dat", "content": "live data\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "bak"}, "expect_created": ["archive", "archive/manifest.txt"], "checks": [{"kind": "line_count", "path": "archive/manifest.txt", "value": {"count_of_tag": "bak"}}, {"kind": "contains_each", "path": "archive/manifest.txt", "texts": {"basenames_of_tag": "bak"}}], "reference": ["mkdir -p archive", "ls -1 *.bak | sort > archive/manifest.txt", "rm -f *.bak"], "max_turns": 5}
{"id": "header-check", "instruction": "Every .csv file in /work should start with the line 'id,name'. Some are missing it. Write the name of each .csv file that is missing the header to missing.txt, one per line, and do not modify any csv file.", "files": [{"name": "{word}.csv", "content": "1,alfa\n", "count": [2, 4], "tag": "noheader"}, {"name": "{word}.csv", "content": "id,name\n1,bravo\n", "count": [1, 2], "tag": "hasheader"}, {"name": "{word}.dat", "content": "x\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["missing.txt"], "checks": [{"kind": "line_count", "path": "missing.txt", "value": {"count_of_tag": "noheader"}}, {"kind": "contains_each", "path": "missing.txt", "texts": {"basenames_of_tag": "noheader"}}], "reference": ["for f in *.csv; do head -n 1 \"$f\" | grep -qx 'id,name' || echo \"$f\"; done | sort > missing.txt"], "max_turns": 5}
{"id": "largest-dat", "instruction": "Write the name of the single largest .dat file in /work to largest.txt. Exactly one file is larger than all the others.", "files": [{"name": "big-{word}.dat", "content": "0123456789012345678901234567890123456789012345678901234567890123456789\n", "count": [1, 1], "tag": "big"}, {"name": "{word}.dat", "content": "tiny\n", "count": [2, 4], "tag": "small"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_created": ["largest.txt"], "checks": [{"kind": "line_count", "path": "largest.txt", "value": 1}, {"kind": "contains_each", "path": "largest.txt", "texts": {"basenames_of_tag": "big"}}], "reference": ["ls -S *.dat | head -n 1 > largest.txt"], "max_turns": 4}
{"id": "strip-blank-lines", "instruction": "Each .txt file in /work contains some completely blank lines. Rewrite every .txt file in place so that it has no blank lines, keeping the other lines in their original order.", "files": [{"name": "{word}.txt", "content": "alpha\n\nbeta\n\n", "count": [2, 4], "tag": "txt"}, {"name": "{word}.log", "content": "untouched\n", "count": [1, 2], "tag": "bystander"}], "expect_modified": {"tag": "txt"}, "checks": [{"kind": "equals", "for_each_tag": "txt", "text": "alpha\nbeta\n"}], "reference": ["for f in *.txt; do grep . \"$f\" > \"$f.new\" && mv \"$f.new\" \"$f\"; done"], "max_turns": 4}
{"id": "sum-ports", "instruction": "Every .conf file in /work has a single line of the form port=NUMBER. Add up all the port numbers and write just the total to total.txt.", "files": [{"name": "{word}.conf", "content": "port={int}\n", "count": [2, 5], "tag": "conf"}, {"name": "{word}.log", "content": "unrelated\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["total.txt"], "checks": [{"kind": "line_count", "path": "total.txt", "value": 1}, {"kind": "contains", "path": "total.txt", "text": {"sum_of_tag": "conf"}}], "reference": ["awk -F= '{s+=$2} END{print s}' *.conf > total.txt"], "max_turns": 4}
{"id": "highest-port", "instruction": "Every .conf file in /work has a single line of the form port=NUMBER. Write just the highest port number you find to highest.txt.", "files": [{"name": "{word}.conf", "content": "port={int}\n", "count": [3, 6], "tag": "conf"}, {"name": "{word}.txt", "content": "notes\n", "count": [1, 2], "tag": "bystander"}], "expect_created": ["highest.txt"], "checks": [{"kind": "line_count", "path": "highest.txt", "value": 1}, {"kind": "contains", "path": "highest.txt", "text": {"max_of_tag": "conf"}}], "reference": ["cat *.conf | cut -d= -f2 | sort -n | tail -n 1 > highest.txt"], "max_turns": 4}
{"id": "delete-large", "instruction": "Delete every file in /work that is larger than 100 bytes. Leave the smaller files alone.", "files": [{"name": "{word}.dat", "content": "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789\n", "count": [2, 4], "tag": "big"}, {"name": "{word}.dat", "content": "tiny {int}\n", "count": [1, 3], "tag": "small"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": {"tag": "big"}, "expect_created": [], "expect_modified": [], "checks": [], "reference": ["find . -type f -size +100c -delete"], "max_turns": 3}
{"id": "list-hidden", "instruction": "Some files in /work are hidden: their names start with a dot. Write the name of every hidden file to hidden.txt, one per line.", "files": [{"name": ".{word}.cfg", "content": "h={int}\n", "count": [2, 4], "tag": "hidden"}, {"name": "{word}.cfg", "content": "v={int}\n", "count": [1, 2], "tag": "visible"}], "expect_deleted": [], "expect_created": ["hidden.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "hidden.txt", "value": {"count_of_tag": "hidden"}}, {"kind": "contains_each", "path": "hidden.txt", "texts": {"basenames_of_tag": "hidden"}}], "reference": ["ls -A | grep '^\\.' | sort > hidden.txt"], "max_turns": 4}
{"id": "debug-enabled-list", "instruction": "Some .conf files in /work contain the line debug=true. Write the name of each of those files to enabled.txt, one per line.", "files": [{"name": "{word}.conf", "content": "debug=true\n", "count": [1, 3], "tag": "on"}, {"name": "{word}.conf", "content": "debug=false\n", "count": [1, 3], "tag": "off"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["enabled.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "enabled.txt", "value": {"count_of_tag": "on"}}, {"kind": "contains_each", "path": "enabled.txt", "texts": {"basenames_of_tag": "on"}}], "reference": ["grep -l '^debug=true$' *.conf | sort > enabled.txt"], "max_turns": 4}
{"id": "replace-in-place", "instruction": "In every .cfg file in /work, replace the word foo with bar. Do not change any other file.", "files": [{"name": "{word}.cfg", "content": "mode=foo\n", "count": [2, 4], "tag": "cfg"}, {"name": "{word}.log", "content": "mode=foo\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": [], "expect_created": [], "expect_modified": {"tag": "cfg"}, "checks": [{"kind": "equals", "for_each_tag": "cfg", "text": "mode=bar\n"}], "reference": ["sed -i 's/foo/bar/' *.cfg"], "max_turns": 3}
{"id": "remove-world-write", "instruction": "Some .conf files in /work are writable by everyone. Remove write permission for other users on every .conf file, without changing anything else about them.", "files": [{"name": "{word}.conf", "content": "k=v\n", "count": [2, 4], "tag": "loose", "mode": "0666"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 2], "tag": "tight", "mode": "0644"}, {"name": "{word}.dat", "content": "d\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": [], "expect_created": [], "expect_modified": {"tag": "loose"}, "checks": [{"kind": "mode", "for_each_tag": "loose", "value": "0664"}], "reference": ["chmod o-w *.conf"], "max_turns": 3}
{"id": "concat-parts", "instruction": "Concatenate all the .part files in /work into a single file called whole.txt. Keep the .part files.", "files": [{"name": "{word}.part", "content": "chunk\n", "count": [2, 5], "tag": "parts"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["whole.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "whole.txt", "value": {"count_of_tag": "parts"}}, {"kind": "regex", "path": "whole.txt", "pattern": "\\A(chunk\\n)+\\Z"}], "reference": ["cat *.part > whole.txt"], "max_turns": 3}
{"id": "list-executables", "instruction": "Write the name of every file in /work that its owner can execute to executables.txt, one per line.", "files": [{"name": "{word}.sh", "content": "#!/bin/sh\necho {int}\n", "count": [2, 4], "tag": "exec", "mode": "0755"}, {"name": "{word}.sh", "content": "#!/bin/sh\necho {int}\n", "count": [1, 3], "tag": "plain", "mode": "0644"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["executables.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "executables.txt", "value": {"count_of_tag": "exec"}}, {"kind": "contains_each", "path": "executables.txt", "texts": {"basenames_of_tag": "exec"}}], "reference": ["find . -maxdepth 1 -type f -perm -u+x | sed 's|^\\./||' | sort > executables.txt"], "max_turns": 4}
{"id": "delete-except-keep", "instruction": "Delete every .dat file in /work except the ones whose name starts with keep_.", "files": [{"name": "keep_{word}.dat", "content": "important {int}\n", "count": [1, 3], "tag": "keep"}, {"name": "{word}.dat", "content": "scrap {int}\n", "count": [2, 4], "tag": "scrap"}, {"name": "{word}.conf", "content": "k=v\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": {"tag": "scrap"}, "expect_created": [], "expect_modified": [], "checks": [], "reference": ["for f in *.dat; do case \"$f\" in keep_*) ;; *) rm \"$f\" ;; esac; done"], "max_turns": 4}
{"id": "find-deep", "instruction": "Write the path of every .conf file under /work, including the ones inside subdirectories, to paths.txt, one per line.", "files": [{"name": "{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}/{word}.conf", "content": "port={int}\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}.txt", "content": "notes\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["paths.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "paths.txt", "value": {"count_of_tag": "conf"}}, {"kind": "contains_each", "path": "paths.txt", "texts": {"names_of_tag": "conf"}}], "reference": ["find . -name '*.conf' | sed 's|^\\./||' | sort > paths.txt"], "max_turns": 4}
{"id": "delete-only-in-logs-dir", "instruction": "Delete every .log file inside the logs directory of /work. Do not touch .log files anywhere else.", "files": [{"name": "logs/{word}.log", "content": "entry {int}\n", "count": [2, 4], "tag": "doomed"}, {"name": "logs/{word}.txt", "content": "keep this\n", "count": [1, 2], "tag": "bystander"}, {"name": "{word}.log", "content": "top level\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": {"tag": "doomed"}, "expect_created": [], "expect_modified": [], "checks": [], "reference": ["rm logs/*.log"], "max_turns": 4}
{"id": "total-lines-tree", "instruction": "Add up the number of non-empty lines across all .txt files under /work, including subdirectories, and write just that total to total.txt.", "files": [{"name": "{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 2], "tag": "counted"}, {"name": "{word}/{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 3], "tag": "counted"}, {"name": "{word}/{word}/{word}.txt", "content": "alpha\n\nbeta\ngamma\n", "count": [1, 2], "tag": "counted"}, {"name": "{word}.md", "content": "ignore me\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["total.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "total.txt", "value": 1}, {"kind": "contains", "path": "total.txt", "text": {"lines_of_tag": "counted"}}], "reference": ["find . -name '*.txt' | xargs cat | grep -c . > total.txt"], "max_turns": 4}
{"id": "largest-in-tree", "instruction": "Write the path of the single largest file under /work, including its directory, to largest.txt. Exactly one file is larger than all the others.", "files": [{"name": "{word}/{word}.dat", "content": "0123456789012345678901234567890123456789012345678901234567890123456789\n", "count": [1, 1], "tag": "big"}, {"name": "{word}.dat", "content": "tiny\n", "count": [1, 2], "tag": "small"}, {"name": "{word}/{word}.dat", "content": "tiny\n", "count": [1, 2], "tag": "small"}, {"name": "{word}.log", "content": "noise\n", "count": [1, 1], "tag": "bystander"}], "expect_deleted": [], "expect_created": ["largest.txt"], "expect_modified": [], "checks": [{"kind": "line_count", "path": "largest.txt", "value": 1}, {"kind": "contains_each", "path": "largest.txt", "texts": {"names_of_tag": "big"}}], "reference": ["find . -type f | xargs ls -S | head -n 1 | sed 's|^\\./||' > largest.txt"], "max_turns": 4}
{"id": "append-tree", "instruction": "Append the line '# reviewed' to the end of every .conf file under /work, including the ones inside subdirectories.", "files": [{"name": "{word}.conf", "content": "setting=on\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}.conf", "content": "setting=on\n", "count": [1, 2], "tag": "conf"}, {"name": "{word}/{word}/{word}.conf", "content": "setting=on\n", "count": [1, 1], "tag": "conf"}, {"name": "{word}.log", "content": "x\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": [], "expect_created": [], "expect_modified": {"tag": "conf"}, "checks": [{"kind": "equals", "for_each_tag": "conf", "text": "setting=on\n# reviewed\n"}], "reference": ["find . -name '*.conf' | while read f; do echo '# reviewed' >> \"$f\"; done"], "max_turns": 4}
{"id": "delete-dir", "instruction": "Delete the cache directory in /work together with everything inside it. Leave everything else alone.", "files": [{"name": "cache/{word}.tmp", "content": "scratch\n", "count": [2, 3], "tag": "doomed"}, {"name": "cache/old/{word}.dat", "content": "stale {int}\n", "count": [1, 2], "tag": "doomed"}, {"name": "{word}.dat", "content": "keep {int}\n", "count": [1, 2], "tag": "bystander"}], "expect_deleted": ["cache", "cache/old", {"tag": "doomed"}], "expect_created": [], "expect_modified": [], "checks": [], "reference": ["rm -r cache"], "max_turns": 4}
